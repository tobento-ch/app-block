{
    "name": "tobento/app-block",
    "version": "2.0.3",
    "type": "library",
    "description": "App block editor.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "block",
        "editor"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/app-console": "^2.0",
        "tobento/app-crud": "^2.0",
        "tobento/app-http": "^2.0",
        "tobento/app-migration": "^2.0",
        "tobento/app-view": "^2.0",
        "tobento/app-logging": "^2.0",
        "tobento/app-user": "^2.0"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "nyholm/psr7": "^1.8",
        "tobento/app-profiler": "^2.0",
        "tobento/app-mail": "^2.0",
        "tobento/app-testing": "^2.0",
        "tobento/apps": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Block\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Block\\Test\\": "tests",
            "Tobento\\Service\\Console\\Test\\": "vendor/tobento/service-console/tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}