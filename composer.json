{
    "name": "tobento/app-block",
    "type": "library",
    "description": "App block editor.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "block",
        "editor"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.0",
        "tobento/app": "^1.0.7",
        "tobento/app-console": "^1.0",
        "tobento/app-crud": "^1.0",
        "tobento/app-http": "^1.0",
        "tobento/app-migration": "^1.0",
        "tobento/app-view": "^1.0",
        "tobento/app-user": "^1.0"
    },  
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "vimeo/psalm": "^4.0",
        "nyholm/psr7": "^1.4",
        "tobento/app-profiler": "^1.0",
        "tobento/app-mail": "^1.0",
        "tobento/app-testing": "^1.0",
        "tobento/apps": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Block\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Block\\Test\\": "tests",
            "Tobento\\Service\\Console\\Test\\": "vendor/tobento/service-console/tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}